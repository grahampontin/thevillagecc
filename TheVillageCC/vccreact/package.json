{
  "name": "vccreact",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "add-to-calendar-button-react": "^2.13.5",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "react": "^19.2.3",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "fetch:openapi": "curl --max-time 120 --retry 3 --retry-delay 15 -f -o cricketclub.json https://api.dev.thevillagecc.org.uk/swagger/v1/swagger.json",
    "generate:openapi": "node ./scripts/strip-bom.js ./cricketclub.json && openapi-typescript ./cricketclub.json -o ./src/api/generated/openapi.ts",
    "generate:openapi:fresh": "npm run fetch:openapi && npm run generate:openapi",
    "check:no-domain-dto-imports": "node ./scripts/check-no-domain-dto-imports.js",
    "verify": "npm run generate:openapi && npm run check:no-domain-dto-imports && npm test -- --watchAll=false && npm run build",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!(@tiptap|prosemirror-|orderedmap|w3c-keyname|rope-sequence)/)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "http-proxy-middleware": "^3.0.5",
    "openapi-typescript": "^6.7.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
