# Local development environment overrides (not committed to git)
# Copy this file to .env.development.local and customize for your local setup

# URL of the IIS backend server
# Examples:
# REACT_APP_API_URL=http://localhost:80
# REACT_APP_API_URL=http://localhost:5000
# REACT_APP_API_URL=http://localhost:8080

# Google Maps API key (override the one in .env.development if needed)
# REACT_APP_GOOGLE_MAPS_API_KEY=your_key_here

