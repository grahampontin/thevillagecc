# Development environment configuration
#
# In development, we call relative /api/* endpoints and CRA's dev server proxies
# them to your local backend using `src/setupProxy.js`.

# Target URL for the dev proxy (used by src/setupProxy.js)
REACT_APP_API_URL=http://localhost:5000

# Optional: if you want to test the frontend against a remote backend without
# using the dev proxy, set an absolute API base URL (no trailing slash), e.g.
# REACT_APP_API_BASE_URL=https://your-api.azurewebsites.net
